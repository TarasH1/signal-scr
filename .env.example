# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SIGNAL_BRIDGE_URL: URL of your Signal-CLI-REST-API instance (e.g., http://localhost:8080)
SIGNAL_BRIDGE_URL=

# SIGNAL_ACCOUNT: The Signal number registered with the bridge.
SIGNAL_ACCOUNT=

# SIGNAL_RECIPIENT: The group ID or phone number to send screenshots to.
SIGNAL_RECIPIENT=
